{
  "name": "system-designs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/render-mermaid.ts --keep-going && vitepress dev",
    "build": "npm run diagrams && vitepress build && node scripts/check-links.ts",
    "diagrams": "node scripts/render-mermaid.ts",
    "preview": "vitepress preview",
    "check": "vue-tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.6.6",
    "@vite-pwa/vitepress": "1.1.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "entities": "7.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "github-slugger": "2.0.0",
    "globals": "17.14.0",
    "markdown-it": "14.3.3",
    "prettier": "3.10.1",
    "puppeteer": "25.16.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite-plugin-pwa": "1.3.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.15.0",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.14"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents": false,
    "puppeteer@25.16.0": true
  }
}
