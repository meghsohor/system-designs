    {
      "id": "r917qsnf6akq",
      "type": "text",
      "x": 1170,
      "y": 1948,
      "width": 299.20000000000005,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
