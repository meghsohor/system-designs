      "seed": 1942833878,
      "version": 1,
      "versionNonce": 507040844,
      "isDeleted": false,
      "updated": 1763000000000,
      "link": null,
      "locked": false,
      "boundElements": null,
      "text": "- Each URL service claims 1,000\n  IDs at a time (atomic increment)\n- base62; start at 62^6 so every\n  code is 7 chars\n- Conditional put: alias taken\n  → 409; collision → next ID\n\nTrade-off: sequential codes are\nguessable → use random codes\nif that matters",
      "originalText": "- Each URL service claims 1,000\n  IDs at a time (atomic increment)\n- base62; start at 62^6 so every\n  code is 7 chars\n- Conditional put: alias taken\n  → 409; collision → next ID\n\nTrade-off: sequential codes are\nguessable → use random codes\nif that matters",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
